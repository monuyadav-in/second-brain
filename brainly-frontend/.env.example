# ─────────────────────────────────────────────────────────────────
# Second Brain — Frontend Environment Variables
#
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
#
# Note: During local development the Vite proxy (vite.config.ts)
# forwards all /api requests to http://localhost:3000 automatically.
# You only need this variable when deploying to a remote host.
# ─────────────────────────────────────────────────────────────────

# Full URL of the deployed backend API (leave empty when using the Vite proxy)
# Example for production: https://api.your-domain.com
VITE_BACKEND_URL=
