# ─────────────────────────────────────────────────────────────────
# Second Brain — Backend Environment Variables
#
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/second-brain
# Atlas:  mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/second-brain
MONGO_URI=mongodb://127.0.0.1:27017/second-brain

# JWT signing secret — use a cryptographically random string of at least 32 characters
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret

# Port the Express server listens on (default: 3000)
PORT=3000
